// ============================================================
// AICTE Complaint Monitoring System — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. Institution
// ============================================================
model Institution {
  id              String   @id @default(uuid())
  aictePermanentId String  @unique @map("aicte_permanent_id")
  name            String
  address         String?
  state           String
  district        String
  region          String?
  city            String?
  type            InstitutionType @default(OTHER)
  approvalStatus  ApprovalStatus  @default(PENDING) @map("approval_status")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  complaints      Complaint[]
  overlapAlerts   OverlapAlert[]

  @@index([state])
  @@index([district])
  @@index([region])
  @@index([approvalStatus])
  @@map("institutions")
}

// ============================================================
// 2. User
// ============================================================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String
  role            UserRole @default(REGULATION_BUREAU_OFFICER)
  bureauId        String?  @map("bureau_id")
  bureau          Bureau?  @relation(fields: [bureauId], references: [id])
  region          String?  @map("region")
  isActive        Boolean  @default(true) @map("is_active")
  passwordHash    String?  @map("password_hash")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  sessions                  Session[]
  assignedComplaints        Complaint[]           @relation("AssignedOfficer")
  createdComplaints         Complaint[]           @relation("ComplaintCreator")
  caseActions               CaseAction[]
  reviewedRelationships     CaseRelationship[]    @relation("RelationshipReviewer")
  reviewedOverlapAlerts     OverlapAlert[]        @relation("OverlapReviewer")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  assignmentHistoryOfficer  ComplaintAssignmentHistory[] @relation("AssignmentOfficer")
  assignmentHistoryAssigner ComplaintAssignmentHistory[] @relation("AssignmentAssigner")

  @@index([role])
  @@index([bureauId])
  @@index([region])
  @@map("users")
}

// ============================================================
// 2b. Session
// ============================================================
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("sessions")
}


// ============================================================
// 3. Bureau
// ============================================================
model Bureau {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  complaints  Complaint[]

  @@map("bureaus")
}

// ============================================================
// 4. ComplaintCategory
// ============================================================
model ComplaintCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  complaints  Complaint[]

  @@map("complaint_categories")
}

// ============================================================
// 5. Complaint
// ============================================================
model Complaint {
  id                  String          @id @default(uuid())
  trackingNumber      String          @unique @map("tracking_number")
  institutionId       String          @map("institution_id")
  institution         Institution     @relation(fields: [institutionId], references: [id])
  categoryId          String          @map("category_id")
  category            ComplaintCategory @relation(fields: [categoryId], references: [id])
  bureauId            String          @map("bureau_id")
  bureau              Bureau          @relation(fields: [bureauId], references: [id])
  assignedToId        String?         @map("assigned_to_id")
  assignedTo          User?           @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  createdById         String          @map("created_by_id")
  createdBy           User            @relation("ComplaintCreator", fields: [createdById], references: [id])

  // Core fields
  receivedDate        DateTime        @map("received_date")
  subject             String
  description         String
  status              ComplaintStatus @default(RECEIVED)
  priority            ComplaintPriority @default(MEDIUM)

  // Complainant info
  complainantName     String?         @map("complainant_name")
  complainantContact  String?         @map("complainant_contact")

  // Action tracking
  nextAction          String?         @map("next_action")
  nextActionDueDate   DateTime?       @map("next_action_due_date")
  expectedDisposalDate DateTime?      @map("expected_disposal_date")
  lastActionAt        DateTime?       @map("last_action_at")
  disposalDate        DateTime?       @map("disposal_date")

  // Timestamps
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  caseActions         CaseAction[]
  sourceRelationships CaseRelationship[] @relation("SourceComplaint")
  targetRelationships CaseRelationship[] @relation("TargetComplaint")
  overlapAlertsA      OverlapAlert[]     @relation("OverlapComplaintA")
  overlapAlertsB      OverlapAlert[]     @relation("OverlapComplaintB")
  assignmentHistory   ComplaintAssignmentHistory[]
  documents           Document[]

  @@index([status])
  @@index([priority])
  @@index([bureauId])
  @@index([assignedToId])
  @@index([institutionId])
  @@index([categoryId])
  @@index([receivedDate])
  @@index([nextActionDueDate])
  @@map("complaints")
}

// ============================================================
// 6. CaseAction
// ============================================================
model CaseAction {
  id              String        @id @default(uuid())
  complaintId     String        @map("complaint_id")
  complaint       Complaint     @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId         String        @map("actor_id")
  actor           User          @relation(fields: [actorId], references: [id])
  actionType      ActionType    @map("action_type")
  previousStatus  ComplaintStatus? @map("previous_status")
  newStatus       ComplaintStatus? @map("new_status")
  remarks         String?
  nextAction      String?       @map("next_action")
  dueDate         DateTime?     @map("due_date")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([complaintId])
  @@index([actorId])
  @@index([actionType])
  @@map("case_actions")
}

// ============================================================
// 7. CaseRelationship
// ============================================================
model CaseRelationship {
  id                String              @id @default(uuid())
  sourceComplaintId String              @map("source_complaint_id")
  sourceComplaint   Complaint           @relation("SourceComplaint", fields: [sourceComplaintId], references: [id], onDelete: Cascade)
  targetComplaintId String              @map("target_complaint_id")
  targetComplaint   Complaint           @relation("TargetComplaint", fields: [targetComplaintId], references: [id], onDelete: Cascade)
  relationshipType  RelationshipType    @map("relationship_type")
  matchingScore     Float?              @map("matching_score")
  matchReasons      Json?               @map("match_reasons")
  reviewStatus      ReviewStatus        @default(PENDING) @map("review_status")
  reviewerId        String?             @map("reviewer_id")
  reviewer          User?               @relation("RelationshipReviewer", fields: [reviewerId], references: [id])
  reviewRemarks     String?             @map("review_remarks")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([sourceComplaintId, targetComplaintId])
  @@index([sourceComplaintId])
  @@index([targetComplaintId])
  @@index([reviewStatus])
  @@map("case_relationships")
}

// ============================================================
// 8. OverlapAlert
// ============================================================
model OverlapAlert {
  id              String            @id @default(uuid())
  complaintAId    String            @map("complaint_a_id")
  complaintA      Complaint         @relation("OverlapComplaintA", fields: [complaintAId], references: [id], onDelete: Cascade)
  complaintBId    String            @map("complaint_b_id")
  complaintB      Complaint         @relation("OverlapComplaintB", fields: [complaintBId], references: [id], onDelete: Cascade)
  institutionId   String?           @map("institution_id")
  institution     Institution?      @relation(fields: [institutionId], references: [id])
  similarityScore Float             @map("similarity_score")
  matchReasons    Json              @map("match_reasons")
  status          OverlapAlertStatus @default(PENDING)
  reviewedById    String?           @map("reviewed_by_id")
  reviewedBy      User?             @relation("OverlapReviewer", fields: [reviewedById], references: [id])
  reviewNote      String?           @map("review_note")
  createdAt       DateTime          @default(now()) @map("created_at")
  reviewedAt      DateTime?         @map("reviewed_at")

  @@unique([complaintAId, complaintBId])
  @@index([status])
  @@index([institutionId])
  @@map("overlap_alerts")
}

// ============================================================
// 9. ComplaintAssignmentHistory
// ============================================================
model ComplaintAssignmentHistory {
  id              String   @id @default(uuid())
  complaintId     String   @map("complaint_id")
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedToId    String   @map("assigned_to_id")
  assignedTo      User     @relation("AssignmentOfficer", fields: [assignedToId], references: [id])
  assignedById    String   @map("assigned_by_id")
  assignedBy      User     @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  reason          String?
  assignedAt      DateTime @default(now()) @map("assigned_at")
  unassignedAt    DateTime? @map("unassigned_at")

  @@index([complaintId])
  @@index([assignedToId])
  @@map("complaint_assignment_history")
}

// ============================================================
// 10. Document
// ============================================================
model Document {
  id              String   @id @default(uuid())
  complaintId     String   @map("complaint_id")
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileName        String   @map("file_name")
  fileType        String   @map("file_type")
  fileSizeBytes   Int?     @map("file_size_bytes")
  storagePath     String   @map("storage_path")
  uploadedById    String?  @map("uploaded_by_id")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([complaintId])
  @@map("documents")
}

// ============================================================
// 11. Notification
// ============================================================
model Notification {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  referenceId     String?           @map("reference_id")
  referenceType   String?           @map("reference_type")
  isRead          Boolean           @default(false) @map("is_read")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

// ============================================================
// 12. AuditLog
// ============================================================
model AuditLog {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id])
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  action          String
  changes         Json?
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  SYSTEM_ADMIN
  PGRC_OFFICER
  REGULATION_BUREAU_OFFICER
  OTHER_BUREAU_OFFICER
  REGIONAL_OFFICER
  SENIOR_MANAGEMENT
  READ_ONLY_AUDITOR
}

enum InstitutionType {
  ENGINEERING
  PHARMACY
  MBA
  MCA
  ARCHITECTURE
  OTHER
}

enum ApprovalStatus {
  APPROVED
  REVOKED
  PENDING
  UNDER_REVIEW
}

enum ComplaintStatus {
  RECEIVED
  UNDER_REVIEW
  INVESTIGATION
  AWAITING_RESPONSE
  RESOLVED
  CLOSED
  ESCALATED
}

enum ComplaintPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ActionType {
  STATUS_CHANGE
  ASSIGNMENT
  REASSIGNMENT
  NOTE_ADDED
  DOCUMENT_ATTACHED
  ESCALATION
  RESPONSE_RECEIVED
  DEADLINE_EXTENDED
  CLOSURE
}

enum RelationshipType {
  DUPLICATE
  RELATED
  FOLLOW_UP
  APPEAL
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum OverlapAlertStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
  LINKED
}

enum NotificationType {
  DEADLINE_WARNING
  OVERLAP_DETECTED
  ASSIGNMENT
  ESCALATION
  STATUS_CHANGE
}
